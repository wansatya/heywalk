# HeyWalk backend configuration (server-side only).
# Never expose these values to browser code and never commit real keys.
# The frontend uses same-origin /api calls (Vite proxy in development).
#
# MODEL_API_KEY, META_API_BASE_URL, and MUSE_MODEL can also be changed at
# runtime via the Settings menu in the web UI (saved back to the .env file).
# Any OpenAI-compatible Chat Completions endpoint works, not just Meta's.

# Model API key for AI generation/correction requests (backend only, no VITE_ prefix).
MODEL_API_KEY=

# Model identifier sent as the chat request model.
MUSE_MODEL=muse-spark-1.3

# Meta Model API base URL (official endpoint; Chat Completions path appended).
# META_API_BASE_URL=https://api.meta.ai/v1

# Per-attempt model request timeout in seconds.
# MODEL_TIMEOUT_S=120

# Allowed browser origins for the API (comma-separated). Same-origin Vite
# proxy in development, so the default ("*") is fine locally.
# CORS_ORIGINS=*

# SQLite database path.
# HEYWALK_DB=./heywalk.db

# Root for one working folder per sequence (<root>/<project_id>/). Empty
# derives "<db_dir>/sequences". Compose sets this to /srv/api/sequences,
# bind-mounted to the repo's ./sequences so the folders are visible on the
# host. For host-side API dev (services/api), set
# HEYWALK_SEQUENCES=../../sequences to land in the same repo folder.
# HEYWALK_SEQUENCES=

# Isolated execution runner backend: none (honest error until configured),
# docker (container-isolated ROS 2 runs), or local (subprocess fallback for
# dev/test only -- NOT container isolation).
# RUNNER_BACKEND=docker
# For manual local dev without Docker, use instead:
# RUNNER_BACKEND=local

# Runner image (build once with: docker compose --profile runner-build build runner).
# The image bundles MuJoCo (headless, MUJOCO_GL=disable) for the primary
# simulation backend; the API image does not need the physics engine.
# RUNNER_IMAGE=heywalk-runner:jazzy

# Per-run isolation limits.
# RUNNER_TIMEOUT_S=180
# RUNNER_CPUS=1.0
# RUNNER_MEMORY=1024m
# RUNNER_PIDS_LIMIT=128
# RUNNER_NETWORK=none

# Correction attempts allowed per failed run before stopping with evidence.
# MAX_FIX_ATTEMPTS=2

# Robot Foundry robot library (one folder per generated robot). Empty derives
# "<api package>/simulator/foundry". For host-side API dev this stays inside
# the checkout; compose sets it to /srv/api/data/foundry (named volume).
# FOUNDRY_ROOT=
# FOUNDRY_WORKERS=2
# FOUNDRY_VALIDATION_TIMEOUT_S=30

# Meta SAM 3.1 segmentation (Foundry analyze stage). Leave SAM31_ENDPOINT
# empty to derive "{META_API_BASE_URL}/responses" when MODEL_API_KEY is set;
# it may also be a full custom Responses URL. SAM31_API_KEY defaults to
# MODEL_API_KEY when empty. When neither is configured the Foundry uses its
# deterministic offline fallback, labelled heuristic_v1 (never as SAM).
# SAM31_ENDPOINT=
# SAM31_API_KEY=
# SAM31_MODEL=sam-3.1
# SAM31_TIMEOUT_S=60

# Optional learned image-to-3D provider (Foundry reconstruct stage). When
# empty the stage uses mask-outline extrusion (labelled outline_extrusion_v1).
# IMAGE_TO_3D_ENDPOINT=
# IMAGE_TO_3D_API_KEY=
# IMAGE_TO_3D_TIMEOUT_S=120
