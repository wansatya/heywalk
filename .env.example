# HeyWalk backend configuration (server-side only).
# Never expose these values to browser code and never commit real keys.
# The frontend uses same-origin /api calls (Vite proxy in development).

# Meta Model API key for Muse Spark requests (backend only, no VITE_ prefix).
MODEL_API_KEY=

# Muse model identifier (verify with a live smoke test before building on it).
MUSE_MODEL=muse-spark-1.3

# Meta Model API base URL (official endpoint; Chat Completions path appended).
# META_API_BASE_URL=https://api.meta.ai/v1

# Per-attempt model request timeout in seconds.
# MODEL_TIMEOUT_S=120

# SQLite database path.
# HEYWALK_DB=./heywalk.db

# Root for one working folder per sequence (<root>/<project_id>/). Empty
# derives "<db_dir>/sequences". Compose sets this to /srv/api/sequences,
# bind-mounted to the repo's ./sequences so the folders are visible on the
# host. For host-side API dev (services/api), set
# HEYWALK_SEQUENCES=../../sequences to land in the same repo folder.
# HEYWALK_SEQUENCES=

# Isolated execution runner backend: none (honest error until configured),
# docker (container-isolated ROS 2 runs), or local (subprocess fallback for
# dev/test only -- NOT container isolation).
# RUNNER_BACKEND=docker

# Runner image (build once with: docker compose --profile runner-build build runner).
# The image bundles MuJoCo (headless, MUJOCO_GL=disable) for the primary
# simulation backend; the API image does not need the physics engine.
# RUNNER_IMAGE=heywalk-runner:jazzy

# Per-run isolation limits.
# RUNNER_TIMEOUT_S=180
# RUNNER_CPUS=1.0
# RUNNER_MEMORY=1024m
# RUNNER_PIDS_LIMIT=128
# RUNNER_NETWORK=none

# Correction attempts allowed per failed run before stopping with evidence.
# MAX_FIX_ATTEMPTS=2
